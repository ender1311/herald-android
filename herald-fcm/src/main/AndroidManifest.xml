<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Apps with their own FirebaseMessagingService remove this one (tools:node="remove") and call
             HeraldNotifications.handleRemoteMessage and Herald.setPushToken from theirs. -->
        <service
            android:name="com.herald.fcm.HeraldMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
